!/book_guides/Chan_QuantTrading/Chan_QuantTrading_ch06_CH.pdf
!/book_guides/Chan_QuantTrading/Chan_QuantTrading_ch07_CH.pdf
!/book_guides/Chan_QuantTrading/Chan_QuantTrading_ch08_CH.pdf
