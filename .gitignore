# This course archive is private by default. Add reviewed public files explicitly.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/COURSE_PLAN.md
!/course/
!/course/**

# QuantTrading is a four-session course; publish only the reviewed PDFs listed below.
!/QuantTrading/
/QuantTrading/*
!/QuantTrading/partA.pdf
!/QuantTrading/partB.pdf
!/QuantTrading/partC.pdf
!/QuantTrading/partD.pdf

# Approved on 2026-10-17: synchronized Chinese Parts B and D.
!/QuantTrading/partB_CH.pdf
!/QuantTrading/partD_CH.pdf

# Student publication uses PDFs; editable teaching sources stay local.
*.md
*.ipynb

# Chinese PDFs stay private unless explicitly approved below.
FinTechCH_week*.pdf
CH_week*.pdf

# Approved on 2026-10-15: publish the reviewed Week 6-8 Chinese PDFs.
!/course/FinTechCH_week6_withClaude.pdf
!/course/FinTechCH_week7_withClaude.pdf
!/course/FinTechCH_week8_withClaude.pdf

# Approved on 2026-10-15: also publish the reviewed Week 2-5 Chinese PDFs.
!/course/FinTechCH_week2_withClaude.pdf
!/course/FinTechCH_week3_withClaude.pdf
!/course/FinTechCH_week4_withClaude.pdf
!/course/FinTechCH_week5_withClaude.pdf

# Approved on 2026-10-17: original Chan book guide only; never the source book.
!/book_guides/
/book_guides/*
!/book_guides/Chan_QuantTrading/
/book_guides/Chan_QuantTrading/*
!/book_guides/Chan_QuantTrading/Chan_QuantTrading_coverage_CH.pdf
!/book_guides/Chan_QuantTrading/Chan_QuantTrading_ch01_CH.pdf
!/book_guides/Chan_QuantTrading/Chan_QuantTrading_ch02_CH.pdf
